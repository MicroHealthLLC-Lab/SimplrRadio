# M5Stack Tab5: settings applied after sdkconfig.defaults. The full configuration is
# sdkconfig.tab5 (committed): rebuild and commit it when changing a setting here.
# Display, touch and audio come from the espressif/m5stack_tab5 BSP, which detects the
# panel (ILI9881C, ST7123 or ST7121).

# --- WiFi co-processor ---------------------------------------------------------------
# The Tab5's ESP32-C6 is on SDIO slot 1 (CLK 12, CMD 13, D0-D3 11/10/9/8), reset on GPIO 15.
# esp_hosted reads the per-slot PRIV keys (the plain SDIO_PIN keys are derived from the slot).
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=15

# --- Display ---------------------------------------------------------------------------
# The 720x1280 panel is shown as 1280x720 landscape; LVGL's frame is rotated by the PPA
CONFIG_LVGL_PORT_ENABLE_PPA=y

# --- Audio -----------------------------------------------------------------------------
CONFIG_CODEC_ES8388_SUPPORT=y

# --- Unused BSP features ---------------------------------------------------------------
# The BSP's camera stack is never started; build no camera sensor drivers
CONFIG_CAMERA_SC2336=n
CONFIG_CAMERA_SC202CS=n
