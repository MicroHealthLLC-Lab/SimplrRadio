# Shared settings for both boards. The board files (sdkconfig.defaults.tab5 for the ESP32-P4
# Tab5, sdkconfig.defaults.tdeck for the ESP32-S3 T-Deck) are applied after this one and set
# the chip; the full configurations (sdkconfig.tab5, sdkconfig.tdeck) are committed: rebuild
# and commit them when changing a setting here.

# --- Flash, compiler ---------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_FREERTOS_HZ=1000
# Optimize for speed (MP3 decode, TLS, rendering); assertions compiled out and problems only in
# the log, as SimplrSSH's builds (whose Tab5 firmware runs this same BSP, LVGL and esp_hosted)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Stack smashing protection for functions with local arrays (parsers of untrusted input)
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# --- Console -----------------------------------------------------------------------
# UART primary + USB-JTAG secondary. USB-JTAG as the primary console is fragile on these
# boards (resets re-enumerate USB and logging stops).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# --- Memory --------------------------------------------------------------------------
# app_main brings up power, display, touch and audio before the app task takes over
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# PSRAM (its type and speed are the board's); skip the full test on every boot
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=n
# Allocations above 16 KB go to PSRAM, keeping internal RAM for stacks, DMA and WiFi
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- WiFi ------------------------------------------------------------------------------
# Station only: no access point (setup happens on the screen)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# WiFi passwords live encrypted in the radio's vault (secret_vault.cpp); the driver keeps no
# plain-text copy (also set at runtime: esp_wifi_set_storage(WIFI_STORAGE_RAM))
CONFIG_ESP_WIFI_NVS_ENABLED=n
# IPv4 only, no DHCP server: nothing listens on the network
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n

# --- Bluetooth -------------------------------------------------------------------------
# Bluetooth LE keyboards and remotes (bt_hid.cpp): NimBLE as a central only. The radio never
# advertises, serves no GATT services and accepts no connections: it scans when asked and
# connects to the devices the user paired. Off until turned on in Menu > Bluetooth.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
# Central (connects) and observer (scans) roles only
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# A GATT client reads the device's key reports; there is no GATT server
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=n
# One device connected at a time, four paired (bt_store.hpp MAX_DEVICES)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# Pairing: LE Secure Connections, legacy pairing for older keyboards. The bonding keys live in
# the radio's encrypted vault (bt_store.cpp); NimBLE keeps none in flash
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# NimBLE's memory in PSRAM; its host task 6 KB (its callbacks save bonds through the vault)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# Keyboards and remotes advertise the classic way: no Bluetooth 5 extended advertising
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# Problems only in the log, as everything else
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# --- TLS ---------------------------------------------------------------------------
# HTTPS for the station directory, streams and sign-in pages, verified with the CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_TLS_INSECURE=n

# --- LVGL ----------------------------------------------------------------------------
# LVGL allocates from the heap, preferring PSRAM (main/lv_mem_psram.c). The fonts each board
# uses are turned on in its own file (Montserrat 14 is LVGL's default font).
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y

# --- Music from the SD card ------------------------------------------------------------
# The music library reads the card's long file names as UTF-8 (FAT32; exFAT isn't supported)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# esp_audio_codec (music_decoder.c) decodes files only: no encoders, and not the codecs that
# Bluetooth audio uses (SBC, LC3, G.722) or MPEG-TS video files
CONFIG_AUDIO_ENCODER_AAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_G711_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=n
CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_ALAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_PCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_SBC_SUPPORT=n
CONFIG_AUDIO_ENCODER_LC3_SUPPORT=n
CONFIG_AUDIO_ENCODER_G722_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
