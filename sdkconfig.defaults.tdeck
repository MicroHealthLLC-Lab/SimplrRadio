# LilyGO T-Deck / T-Deck Plus (ESP32-S3, 16 MB flash, 8 MB octal PSRAM): settings applied
# after sdkconfig.defaults. The full configuration is sdkconfig.tdeck (committed): rebuild and
# commit it when changing a setting here. Display and pin settings as SimplrSSH's T-Deck build.

# --- Chip, CPU, PSRAM ------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Internal RAM is scarce on the S3: keep 32 KB of it for DMA and WiFi
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# --- Bluetooth --------------------------------------------------------------------------
# NimBLE with the ESP32-S3's own Bluetooth LE controller (shared settings in sdkconfig.defaults)
CONFIG_BT_CONTROLLER_ENABLED=y
# The controller's code runs from flash, not internal RAM: that RAM stays for WiFi, TLS and the
# stream (a keyboard's keys need no IRAM speed)
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y

# --- Display: ST7789 320x240 on SPI (esp_bsp_generic), GT911 touch on I2C ----------------
# The system I2C bus (touch panel, keyboard)
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_I2C_GPIO_SCL=8
CONFIG_BSP_I2C_GPIO_SDA=18
# No BSP buttons (the trackball is read by tdeck_keyboard.c); the BSP's LED is never created
CONFIG_BSP_BUTTONS_NUM=0
# The display: SPI pins, ST7789 driver, landscape (swap XY, mirror X), inverted colours
CONFIG_BSP_DISPLAY_ENABLED=y
CONFIG_BSP_DISPLAY_INTERFACE_SPI=y
CONFIG_BSP_DISPLAY_SCLK_GPIO=40
CONFIG_BSP_DISPLAY_MOSI_GPIO=41
CONFIG_BSP_DISPLAY_MISO_GPIO=38
CONFIG_BSP_DISPLAY_CS_GPIO=12
CONFIG_BSP_DISPLAY_DC_GPIO=11
CONFIG_BSP_DISPLAY_RST_GPIO=-1
CONFIG_BSP_DISPLAY_BACKLIGHT_GPIO=42
CONFIG_BSP_DISPLAY_DRIVER_ST7789=y
CONFIG_BSP_DISPLAY_ROTATION_SWAP_XY=y
CONFIG_BSP_DISPLAY_ROTATION_MIRROR_X=y
CONFIG_BSP_DISPLAY_COLOR_SPACE_RGB=y
CONFIG_BSP_DISPLAY_INVERT_COLOR=y
CONFIG_BSP_DISPLAY_PIXEL_CLOCK=40
CONFIG_BSP_DISPLAY_WIDTH=320
CONFIG_BSP_DISPLAY_HEIGHT=240
CONFIG_BSP_DISPLAY_BRIGHTNESS_LEDC_CH=1
# 320 x 50 lines (32 KB) of internal DMA memory per draw buffer
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=50
# Fonts: 12 (hints, text), 14 (title bar, rows), 20 (station name)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# --- Unused codec drivers ----------------------------------------------------------------
# The speaker is a plain I2S amplifier (MAX98357A); esp_bsp_generic builds no codec drivers
CONFIG_CODEC_ES8311_SUPPORT=n
CONFIG_CODEC_ES7210_SUPPORT=n
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
